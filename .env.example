# Next.js Clerk keys: .env.local = "LendLoop Dev" keys (DEV);
# Vercel env vars, Production scope only = "LendLoop Prod" keys (PROD)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# DEV: written automatically by `npx convex dev`.
# PROD: NOT set in Vercel — `npx convex deploy --cmd 'npm run build'` injects
# NEXT_PUBLIC_CONVEX_URL / NEXT_PUBLIC_CONVEX_SITE_URL into the build, and the
# deploy key selects the deployment (no CONVEX_DEPLOYMENT needed).
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# PROD only: Convex production deploy key (permission deployment:deploy),
# stored only in Vercel env vars, Production scope, Sensitive.
# NEVER put it in .env.local — the Convex CLI would target PROD.
# CONVEX_DEPLOY_KEY=

# NOTE: these live in Convex env vars (npx convex env set), NOT here:
# CLERK_JWT_ISSUER_DOMAIN, N8N_WEBHOOK_URL, N8N_WEBHOOK_SECRET
# Convex DEV: `npx convex env set N8N_WEBHOOK_URL …` / `N8N_WEBHOOK_SECRET …`;
# the secret must match the n8n `HMAC DEV` credential's Hmac Secret. Never here.
