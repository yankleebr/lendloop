    {
      "parameters": {
        "jsCode": "const e = $input.first().json.event;\nconst PREFIX = '';\nconst oneLine = (s) => String(s).replace(/[\\r\\n]+/g, ' ');\nconst tool = e.tool.name;\nconst me = e.recipient.name;\nconst other = e.counterpart.name;\nconst period = `${e.loan.startDate} → ${e.loan.endDate}`;\n\nfunction rejectedText() {\n  if (e.loan.closeReason === 'period_taken') {\n    return `Hi ${me}, your request for ${tool} (${period}) was not approved: those dates were given to another neighbor.`;\n  }\n  if (e.loan.closeReason === 'tool_removed') {\n    const by = e.loan.removedByModerator ? ' by a moderator' : '';\n    return `Hi ${me}, your request for ${tool} (${period}) was closed because the listing was removed${by}.`;\n  }\n  return `Hi ${me}, ${other} rejected your request for ${tool} (${period}).`;\n}\n\nconst templates = {\n  'loan.requested': [\n    `${other} wants to borrow your ${tool}`,\n    `Hi ${me}, ${other} asked to borrow your ${tool} from ${e.loan.startDate} to ${e.loan.endDate}. Open LendLoop → Incoming requests to approve or reject.`,\n  ],\n  'loan.approved': [\n    `Your request for ${tool} was approved`,\n    `Hi ${me}, ${other} approved your request for ${tool} (${period}).`,\n  ],\n  'loan.rejected': [`Your request for ${tool} was not approved`, rejectedText()],\n  'loan.cancelled': [\n    `${other} cancelled a request for your ${tool}`,\n    `Hi ${me}, ${other} cancelled the request for ${tool} (${period}).`,\n  ],\n  'loan.returned': [\n    `${tool} marked as returned`,\n    `Hi ${me}, ${other} confirmed that ${tool} was returned. Thanks for borrowing responsibly!`,\n  ],\n};\n\nconst [subject, text] = templates[e.type];\nreturn [{\n  json: {\n    channel: 'mock',\n    eventId: e.eventId,\n    type: e.type,\n    recipientId: e.recipient._id,\n    to: e.recipient.email ?? '',\n    subject: oneLine(PREFIX + subject),\n    text,\n  },\n}];\n"
      },
