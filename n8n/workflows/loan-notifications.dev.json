    {
      "parameters": {
        "jsCode": "const { timingSafeEqual } = require('crypto');\nconst TOLERANCE_SEC = 300;\nconst TYPES = ['loan.requested', 'loan.approved', 'loan.rejected', 'loan.cancelled', 'loan.returned'];\nconst { timestamp, signatureHeader, rawBody, expectedHex } = $input.first().json;\nconst reject = (status) => [{ json: { valid: false, status } }];\n\nif (!/^\\d+$/.test(timestamp) || !expectedHex) return reject(401);\nconst expected = Buffer.from(`v1=${expectedHex}`, 'utf8');\nconst matches = signatureHeader\n  .split(' ')\n  .filter((sig) => sig.startsWith('v1='))\n  .some((sig) => {\n    const provided = Buffer.from(sig, 'utf8');\n    return provided.length === expected.length && timingSafeEqual(provided, expected);\n  });\nif (!matches) return reject(401);\nif (Math.abs(Math.floor(Date.now() / 1000) - Number(timestamp)) > TOLERANCE_SEC) return reject(401);\n\nlet event;\ntry {\n  event = JSON.parse(rawBody);\n} catch {\n  return reject(400);\n}\nif (event?.version !== 1 || !event.eventId || !TYPES.includes(event.type) || !event.recipient) {\n  return reject(400);\n}\nreturn [{ json: { valid: true, status: 200, event } }];\n"
      },
