      "name": "Error Trigger"
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst workflowName = String(data.workflow?.name ?? 'unknown workflow');\nconst exec = data.execution;\nconst oneLine = (s) => String(s ?? '').replace(/[\\r\\n]+/g, ' ').trim();\nconst truncate = (s, n) => (s.length > n ? s.slice(0, n) + '…' : s);\n\nconst message = truncate(oneLine(exec ? exec.error?.message : data.trigger?.error?.message) || 'no message', 300);\n\nconst lines = [\n  `Workflow: ${workflowName}`,\n  `Execution: ${exec?.id ?? 'n/a (trigger failed)'}`,\n  `URL: ${exec?.url ?? 'n/a'}`,\n  `Failed node: ${exec?.lastNodeExecuted ?? 'trigger'}`,\n  `Mode: ${exec?.mode ?? data.trigger?.mode ?? 'unknown'}`,\n  '',\n  `Error: ${message}`,\n  '',\n  '— LendLoop automation',\n];\n\nreturn [{\n  json: {\n    subject: truncate(`[DEV] n8n workflow failed: ${oneLine(workflowName)}`, 150),\n    text: lines.join('\\n'),\n  },\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
